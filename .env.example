# Copy to .env and fill in.

# GPT chat, batch, and text-embedding-3-large
OPENAI_API_KEY=
# Corpus construction (courtlistener/fetch_courtlistener.py)
COURTLISTENER_API_KEY=

# Gemini 2.5 Pro on Vertex AI (vertex.py). PROJECT and BUCKET are required for
# Gemini calls; the service account is optional (impersonation).
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=us-central1
GOOGLE_IMPERSONATE_SERVICE_ACCOUNT=
GCS_BATCH_BUCKET=
